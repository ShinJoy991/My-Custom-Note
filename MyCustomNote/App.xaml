<Application x:Class="MyCustomNote.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Starting colours (Light theme). ThemeManager replaces these at start-up and whenever the theme changes. -->
        <SolidColorBrush x:Key="Brush.Window" Color="#FFFBFE" />
        <SolidColorBrush x:Key="Brush.PaneLeft" Color="#F0ECEF" />
        <SolidColorBrush x:Key="Brush.PaneMiddle" Color="#F8F4F7" />
        <SolidColorBrush x:Key="Brush.Text" Color="#1C1B1F" />
        <SolidColorBrush x:Key="Brush.TextMuted" Color="#575559" />
        <SolidColorBrush x:Key="Brush.Border" Color="#D6D2D5" />
        <SolidColorBrush x:Key="Brush.Primary" Color="#6650A4" />
        <SolidColorBrush x:Key="Brush.OnPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Brush.BodyText" Color="#1C1B1F" />
        <SolidColorBrush x:Key="Brush.HeadingText" Color="#1C1B1F" />
        <FontFamily x:Key="Font.Note">Segoe UI</FontFamily>
    </Application.Resources>
</Application>
