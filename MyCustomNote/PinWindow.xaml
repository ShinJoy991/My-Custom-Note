<Window x:Class="MyCustomNote.PinWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}">
    <StackPanel Margin="20">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel x:Name="Fields" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#E53935" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Width="90" Padding="0,5" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Padding="0,5" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
