<Window x:Class="MyCustomNote.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="480" Height="640" MinWidth="420" MinHeight="480"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">

            <TextBlock Text="Theme" FontSize="14" FontWeight="SemiBold" />
            <WrapPanel x:Name="ThemePanel" Margin="0,8,0,18" />

            <TextBlock Text="Font" FontSize="14" FontWeight="SemiBold" />
            <WrapPanel x:Name="FontPanel" Margin="0,8,0,18" />

            <TextBlock Text="Body text color" FontSize="14" FontWeight="SemiBold" />
            <WrapPanel x:Name="BodyColorPanel" Margin="0,8,0,18" />

            <TextBlock Text="Heading color" FontSize="14" FontWeight="SemiBold" />
            <WrapPanel x:Name="HeadingColorPanel" Margin="0,8,0,8" />

            <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,14"
                       Foreground="{DynamicResource Brush.TextMuted}"
                       Text="If a color is hard to read on the current theme (for example white on the Light theme), the theme's own color is used instead." />

            <TextBlock Text="Trash" FontSize="14" FontWeight="SemiBold" />
            <TextBlock Text="Notes in the trash are deleted for good after:" FontSize="12" Margin="0,2,0,0"
                       Foreground="{DynamicResource Brush.TextMuted}" />
            <WrapPanel x:Name="TrashPanel" Margin="0,8,0,18" />

            <TextBlock Text="Security" FontSize="14" FontWeight="SemiBold" />
            <StackPanel x:Name="SecurityPanel" Margin="0,8,0,18" />

            <TextBlock Text="Preview" FontSize="14" FontWeight="SemiBold" />
            <Border Margin="0,8,0,18" Padding="16" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource Brush.Window}"
                    BorderBrush="{DynamicResource Brush.Border}">
                <StackPanel>
                    <!-- The same sizes, fonts and colors as in a note: title 24, heading line 20, body 15. -->
                    <TextBlock Text="Sample title" FontSize="24"
                               FontFamily="{DynamicResource Font.Note}"
                               Foreground="{DynamicResource Brush.HeadingText}" />
                    <TextBlock Text="Sample heading line" FontSize="20" Margin="0,12,0,0"
                               FontFamily="{DynamicResource Font.Note}"
                               Foreground="{DynamicResource Brush.HeadingText}" />
                    <TextBlock Text="The quick brown fox jumps over the lazy dog. 0123456789" Margin="0,6,0,0"
                               FontSize="15" TextWrapping="Wrap"
                               FontFamily="{DynamicResource Font.Note}"
                               Foreground="{DynamicResource Brush.BodyText}" />
                </StackPanel>
            </Border>

            <Button Content="Close" Padding="20,6" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
