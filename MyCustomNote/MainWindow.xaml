<Window x:Class="MyCustomNote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MyCustomNote.ViewModels"
        xmlns:local="clr-namespace:MyCustomNote"
        Title="MyCustomNote"
        Width="1100" Height="700" MinWidth="820" MinHeight="480"
        Background="{DynamicResource Brush.Window}"
        Foreground="{DynamicResource Brush.Text}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewNoteCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="ApplicationCommands.Save" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <!-- Ctrl+F is the built-in gesture of the Find command. -->
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" />
    </Window.CommandBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource Brush.PaneLeft}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="MyCustomNote" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,16,0" />

                <Grid Grid.Column="1" MaxWidth="460">
                    <TextBox x:Name="SearchBox" Padding="8,5"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Search notes (Ctrl+F)" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button Content="New note" Padding="12,5" Margin="0,0,8,0" ToolTip="Ctrl+N"
                            Command="{Binding NewNoteCommand}" />
                    <Button Content="Import" Padding="12,5" Margin="0,0,8,0" Click="Import_Click"
                            ToolTip="Import notes from .md, .txt or .json files" />
                    <Button x:Name="ExportButton" Content="Export" Padding="12,5" Margin="0,0,8,0" Click="Export_Click"
                            IsEnabled="False"
                            ToolTip="Export the selected notes as .md, .txt, .html or .json files" />
                    <Button Content="Settings" Padding="12,5" Click="SettingsButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Three panes -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="220" MinWidth="140" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="MiddleColumn" Width="320" MinWidth="220" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!-- Left pane: sections, folders, tags -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.PaneLeft}">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" Padding="6"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" Padding="6,4" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NavKind.Header}">
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="Margin" Value="0,10,0,0" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NavKind.Placeholder}">
                                                <Setter Property="FontStyle" Value="Italic" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="1" Content="+ New folder" Margin="10" Padding="8,5" Click="NewFolder_Click" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Brush.Border}" />

            <!-- Middle pane: note list -->
            <Grid Grid.Column="2" Background="{DynamicResource Brush.PaneMiddle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Sort chips (created in code): the active one shows a check mark. -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding ModeLabel}" Margin="12,8,8,0" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Primary}"
                               Visibility="{Binding HasModeLabel, Converter={StaticResource BoolToVis}}" />
                    <WrapPanel x:Name="SortChips" Margin="8,8,8,2" />
                </StackPanel>

                <ListBox x:Name="NoteList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="6"
                         SelectionMode="Extended"
                         HorizontalContentAlignment="Stretch"
                         ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNote, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- color tag stripe -->
                                <Border Grid.Column="0" CornerRadius="2" Margin="0,4"
                                        Background="{Binding ColorBrush}" />
                                <StackPanel Grid.Column="1" Margin="8,6,4,6">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               FontFamily="{DynamicResource Font.Note}"
                                               Foreground="{DynamicResource Brush.HeadingText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Preview}" Margin="0,2,0,0"
                                               FontFamily="{DynamicResource Font.Note}"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding DateText}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                        <TextBlock Text="  ·  Pinned" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding ChecklistText}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextMuted}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding TagsText}" FontSize="11" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Centered empty state -->
                <TextBlock Text="{Binding EmptyMessage}" Grid.Row="1" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                           IsHitTestVisible="False"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource Brush.Border}" />

            <!-- Right pane: the note editor -->
            <Grid Grid.Column="4" Background="{DynamicResource Brush.Window}">
                <TextBlock Text="Select a note to edit it.&#10;Press Ctrl+N to create a new one."
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVis}}" />

                <local:NoteEditorView x:Name="NoteEditor"
                                      Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
