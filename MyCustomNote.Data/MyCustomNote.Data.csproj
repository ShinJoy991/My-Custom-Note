<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Data.Sqlite.Core + the SQLCipher bundle instead of Microsoft.Data.Sqlite: the same API, but the
         native SQLite is SQLCipher, which can encrypt the whole database file (and still opens plain files). -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyCustomNote.Core\MyCustomNote.Core.csproj" />
    <InternalsVisibleTo Include="MyCustomNote.Data.Tests" />
  </ItemGroup>

</Project>
